<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.example</groupId>
  <artifactId>sqli-burp-extension</artifactId>
  <version>0.1.0</version>
  <packaging>jar</packaging>
  <name>SQLi Burp Extension</name>
  <description>Simple Burp Suite extension to generate blind SQLi payloads.</description>
  <properties>
    <maven.compiler.source>21</maven.compiler.source>
    <maven.compiler.target>21</maven.compiler.target>
  </properties>
  <dependencies>
    <!-- Montoya (Burp's Montoya API) dependency.
         The template project uses coordinates `net.portswigger.burp.extensions:montoya-api:2026.7`.
         If this artifact is not available from a remote repo, activate the `use-montoya` profile
         with `-Dmontoya.jar=/path/to/montoya.jar` to install a local JAR into your repo before build.
    -->
    <dependency>
      <groupId>net.portswigger.burp.extensions</groupId>
      <artifactId>montoya-api</artifactId>
      <version>2026.7</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.10.2</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.11.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.2.0</version>
        <configuration>
          <archive>
            <manifestEntries>
              <Extension-Name>SQLi Burp Extension</Extension-Name>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>
  <!--
    Profile to install a local Montoya JAR into the local Maven repository at build time.
    Activate like: -Puse-montoya -Dmontoya.jar=/absolute/path/to/montoya.jar
  -->
  <profiles>
    <profile>
      <id>use-montoya</id>
      <activation>
        <property>
          <name>montoya.jar</name>
        </property>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-install-plugin</artifactId>
            <version>2.5.2</version>
            <executions>
              <execution>
                <id>install-montoya</id>
                <phase>initialize</phase>
                <goals>
                  <goal>install-file</goal>
                </goals>
                <configuration>
                  <file>${montoya.jar}</file>
                  <groupId>net.portswigger.burp.extensions</groupId>
                  <artifactId>montoya-api</artifactId>
                  <version>2026.7</version>
                  <packaging>jar</packaging>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
